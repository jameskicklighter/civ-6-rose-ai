<?xml version="1.0" encoding="utf-8"?>
<Mod id="a1b2c3d4-e5f6-4a01-b0de-f6a7b8c9d0e1" version="1">
  <Properties>
    <Name>[COLOR:ResScienceLabelCS]Rose AI Mod[ENDCOLOR]</Name>
    <Description>AI Behaviour Tweaks - Economy-focused AI improvements for smarter district building and tech priorities.</Description>
    <Teaser>Smarter AI economy decisions.</Teaser>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <Authors>Rose</Authors>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>

  <InGameActions>

    <UpdateDatabase id="ROSE_AI">
      <Properties>
        <LoadOrder>600</LoadOrder>
      </Properties>
      <File>core/strategies/Rose_Strategies.sql</File>
      <File>core/strategies/Rose_Strategy_Lists.sql</File>
      <File>core/leaders/Rose_Leader_Traits.sql</File>
      <File>core/leaders/Rose_Leader_Lists.sql</File>
      <File>core/economy/Rose_Techs_Civics.sql</File>
      <File>core/economy/Rose_Yields.sql</File>
      <File>core/economy/Rose_Districts.sql</File>
      <File>core/economy/Rose_Units.sql</File>
      <File>core/choices/Rose_Belief_Signals.sql</File>
      <File>core/choices/Rose_Policy_Signals.sql</File>
      <File>core/military/Rose_Operation_Roles.sql</File>
      <File>core/military/Operations.xml</File>
      <File>core/military/trees/Simple_Operation_Attack.xml</File>
      <File>core/military/trees/Simple_City_Defense.xml</File>
      <File>core/military/trees/Naval_Superiority.xml</File>
      <File>core/military/trees/Siege_City_Assault.xml</File>
      <File>core/military/trees/Early_City_Assault.xml</File>
      <File>core/military/trees/Nuclear_Assault.xml</File>
      <File>core/military/trees/Rose_Nuclear_Strike.xml</File>
      <File>core/military/trees/Rose_Wartime_Siege.xml</File>
    </UpdateDatabase>

    <ImportFiles id="ROSE_AI_MODULES">
      <File>core/scripts/Rose_AI_Core.lua</File>
      <File>core/scripts/Rose_AI_Civics.lua</File>
      <File>core/scripts/Rose_AI_Strategies.lua</File>
      <File>core/scripts/Rose_AI_Naval.lua</File>
      <File>core/scripts/Rose_AI_Nuclear.lua</File>
      <File>core/scripts/Rose_AI_Director.lua</File>
      <File>core/scripts/Rose_AI_Diagnostics.lua</File>
    </ImportFiles>

    <AddUserInterfaces id="ROSE_AI_INGAME_BRIDGE">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>core/scripts/Rose_AI_InGame.xml</File>
    </AddUserInterfaces>

    <AddGameplayScripts id="ROSE_AI_SCRIPTS">
      <File>core/scripts/Rose_AI_ChoiceMarkers.lua</File>
      <File>core/scripts/Rose_AI_Gameplay.lua</File>
    </AddGameplayScripts>

  </InGameActions>

  <Files>
    <File>core/strategies/Rose_Strategies.sql</File>
    <File>core/strategies/Rose_Strategy_Lists.sql</File>
    <File>core/leaders/Rose_Leader_Traits.sql</File>
    <File>core/leaders/Rose_Leader_Lists.sql</File>
    <File>core/economy/Rose_Techs_Civics.sql</File>
    <File>core/economy/Rose_Yields.sql</File>
    <File>core/economy/Rose_Districts.sql</File>
    <File>core/economy/Rose_Units.sql</File>
    <File>core/choices/Rose_Belief_Signals.sql</File>
    <File>core/choices/Rose_Policy_Signals.sql</File>
