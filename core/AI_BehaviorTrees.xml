<!--
Rose AI behavior tree changes, adapted from RomanHoliday AI.

How to read this file:
- BehaviorTreeNodes is the flat list of behavior steps.
- NodeId is the local address of one step inside one TreeName.
- JumpTo marks the end of a control node's child block.
- TreeData sets parameters for nodes by TreeName + NodeId + DefnId.
- DefnId depends on the node type. For example, DefnId 0 means
  AutoProtect Percentage on Operation Defend Units, but it means
  Pillage Districts on Operation Pillage.

Applied here:
- Replacement Simple City Defense tree.
- Replacement Naval Superiority Tree.
- Replacement Siege City Assault tree: about 15-turn limit on initial assembly.
- Naval Superiority team exclusions for non-naval unit categories.
- Lower city-assault strength ratios so assembled armies can proceed.
- Siege-unit (or, late, bomber) requirement for walled-city attacks.
- Settlement escort limits that reserve siege units for military operations.
- Small data tuning for Simple Operation Attack and Early City Assault.

Not applied here:
- RH Air Blitz Tree. The source tree contains an obvious TreeName typo
  and mixes air assault with nuclear-launch nodes, so it needs save testing.
- RH City Air Defense Tree. The source tree is not wired to a Rose operation,
  so defining it would not do anything by itself.
- RH Nuclear Assault replacement. It changes WMD behavior and the source notes
  several contract/recruit rows as uncertain, so it is too risky for this pass.
-->

<GameInfo>

  <!--
  Base-game attack tree names are target-based, not era-based:
  - Simple Operation Attack attacks barbarian camps; it is not a city tree.
  - Early City Assault attacks cities without walls in any era.
  - Siege City Assault attacks walled cities in any era and adds formation,
    siege positioning, siege-support, and air-assault behavior.

  Attack Enemy City / Attack Walled City can assemble before war and use the
  trees' diplomacy phases. Their Wartime variants require an existing war and
  use lower force/odds gates so the AI can react to an ongoing conflict.
  -->

  <AiOperationTeams>
    <!--
    Base city-assault ratios require much larger strength advantages than the
    operations can usually recruit. Lower ratios let assembled forces proceed
    without reducing the operation's target, odds, or minimum-unit safeguards.
    -->
    <Update>
      <Where TeamName="Simple City Attack Force" OperationName="Attack Enemy City" />
      <Set InitialStrengthAdvantage="0.8" OngoingStrengthAdvantage="1.6" />
    </Update>
    <Update>
      <Where TeamName="Simple City Attack Force" OperationName="Wartime Attack Enemy City" />
      <Set InitialStrengthAdvantage="0.4" OngoingStrengthAdvantage="0.8" />
    </Update>
    <Update>
      <Where TeamName="City Attack Force" OperationName="Attack Walled City" />
      <!-- Preserve more caution than 1.5 without restoring the base game's stall-prone value of 4.0. -->
      <Set InitialStrengthAdvantage="1.0" OngoingStrengthAdvantage="1.75" />
    </Update>
    <Update>
      <Where TeamName="City Attack Force" OperationName="Wartime Attack Walled City" />
      <Set InitialStrengthAdvantage="0.6" OngoingStrengthAdvantage="1.0" />
    </Update>
    <!-- Soft role maxima were exceeded in logs; this hard cap permits one Settler plus at most two escorts. -->
    <Update>
      <Where TeamName="Settle City Team" OperationName="Settle New City" />
      <Set MaxUnits="3" />
    </Update>
    <!-- Lua seeds one ship; local recruitment may add at most two nearby ships. -->
    <Update>
      <Where TeamName="Naval Superiority Force" OperationName="Naval Superiority" />
      <Set MaxUnits="3" />
    </Update>
  </AiOperationTeams>

  <OpTeamRequirements>
    <!--
    Walled-city attacks require one unit that can damage walls: a trainable
    bombard-capable siege unit or, from the Modern era, a bomber
    (UNITTYPE_ROSE_SIEGE_STRIKE, derived in AI_BehaviorTreeOps.sql), so late
    walled attacks need not wait for a ground siege unit. The role has no
    maximum of its own: UNITTYPE_SIEGE (max 3) and UNITTYPE_AIR_SIEGE (max 2)
    still cap ground siege and bombers separately.
    UNITTYPE_SIEGE_ALL is broader and also includes rams, towers, anti-air,
    Mobile SAMs, and the Giant Death Robot, so it is not the minimum. The tags
    overlap: one Catapult satisfies all three, and one Bomber satisfies the
    strike role and AIR_SIEGE.
    -->
    <Update>
      <Where TeamName="City Attack Force" AiType="UNITTYPE_SIEGE" />
      <Set MinNumber="0" MaxNumber="3" />
    </Update>
    <Replace TeamName="City Attack Force" AiType="UNITTYPE_ROSE_SIEGE_STRIKE" MinNumber="1" />
    <Update>
      <Where TeamName="City Attack Force" AiType="UNITTYPE_SIEGE_ALL" />
      <Set MinNumber="0" />
    </Update>
    <!-- The base Siege City Assault tree already directs recruited bombers. -->
    <Update>
      <Where TeamName="City Attack Force" AiType="UNITTYPE_AIR_SIEGE" />
      <Set MinNumber="0" MaxNumber="2" />
    </Update>

    <!--
    City Defense may steal nearby generic combat units from other operations.
    Exclude bombard units so emergency defense cannot drain the mandatory siege
    unit from a walled-city assault and trigger replacement contracts. Keep the
    broader SIEGE_ALL role available because it also includes defensive anti-air.
    -->
    <Replace TeamName="City Defense" AiType="UNITTYPE_SIEGE" MinNumber="0" MaxNumber="0" />

    <!-- Bombers are AIR_SIEGE rather than AIR and cannot execute the simple attack tree's ground movement. -->
    <Replace TeamName="Simple Early Attack Force" AiType="UNITTYPE_AIR_SIEGE" MinNumber="0" MaxNumber="0" />

    <!--
    Settlement operations need one escort but should not absorb an unlimited
    number of combat units or divert bombard/support/air units from city attacks.
    The single active settlement operation can recruit at most two ordinary
    combat escorts; siege-tagged and bomber units are excluded from the team.
    -->
    <Update>
      <Where TeamName="Settle City Team" AiType="UNITAI_COMBAT" />
      <Set MinNumber="1" MaxNumber="2" />
    </Update>
    <Replace TeamName="Settle City Team" AiType="UNITTYPE_SIEGE" MinNumber="0" MaxNumber="0" />
    <Replace TeamName="Settle City Team" AiType="UNITTYPE_SIEGE_ALL" MinNumber="0" MaxNumber="0" />
    <Replace TeamName="Settle City Team" AiType="UNITTYPE_AIR_SIEGE" MinNumber="0" MaxNumber="0" />

    <!--
    Keep the scripted ship-interception force small and combat-only.
    UNITTYPE_NAVAL alone does not stop generic melee/ranged roles from selecting
    land or air units, while the base civilian-leader allowance admitted teams
    made mostly or entirely of Great Admirals.
    -->
    <Replace TeamName="Naval Superiority Force" AiType="UNITTYPE_MELEE" MinNumber="1" MaxNumber="2" />
    <Replace TeamName="Naval Superiority Force" AiType="UNITTYPE_RANGED" MinNumber="0" MaxNumber="1" />
    <Replace TeamName="Naval Superiority Force" AiType="UNITTYPE_CIVILIAN_LEADER" MinNumber="0" MaxNumber="0" />
    <Replace TeamName="Naval Superiority Force" AiType="UNITTYPE_LAND_COMBAT" MinNumber="0" MaxNumber="0" />
    <Replace TeamName="Naval Superiority Force" AiType="UNITTYPE_AIR" MinNumber="0" MaxNumber="0" />
    <Replace TeamName="Naval Superiority Force" AiType="UNITTYPE_AIR_SIEGE" MinNumber="0" MaxNumber="0" />
    <Replace TeamName="Naval Superiority Force" AiType="UNITTYPE_NUCLEAR" MinNumber="0" MaxNumber="0" />
  </OpTeamRequirements>

  <AiOperationDefs>
    <!-- Native self-start produced hundreds of empty operations. Lua now starts this only for a real ship-vs-ship target. -->
    <Update>
      <Where OperationName="Naval Superiority" />
      <Set SelfStart="false" />
    </Update>

    <!--
    Walled-city reach. From about turn 75 almost every city target is walled,
    so these limits govern nearly all mid/late attacks (unwalled attacks keep
    the base 30/45). The earlier 8/10 cap kept armies local but left real war
    enemies out of range: Phoenicia never targeted Byzantium's Thessalonica,
    about 10 tiles away, during a 22-turn war (2026-10-03 log). Area and world
    limits follow RH (planned 16/15, wartime 22/21) except the planned
    cross-area limit, which stays near Rose's previous 10 (base 0) because
    planned overseas sieges rarely succeed. Rose sets the region limit equal
    to the area limit; base and RH leave region at -1.
    Base: planned 30 in-area / 0 world; wartime 45 / unlimited.
    -->
    <Update>
      <Where OperationName="Attack Walled City" />
      <Set MaxTargetDistInRegion="16" MaxTargetDistInArea="16" MaxTargetDistInWorld="12" />
    </Update>
    <Update>
      <Where OperationName="Wartime Attack Walled City" />
      <Set MaxTargetDistInRegion="22" MaxTargetDistInArea="22" MaxTargetDistInWorld="21" />
    </Update>
  </AiOperationDefs>

  <!--
  Existing tree tuning: Simple Operation Attack

  RH raises the recruit range on the early recruitment node. This makes the
  operation less likely to stall because it can pull units from farther away.
  -->
  <TreeData>
    <Row DefnId="2" NodeId="8" TreeName="Simple Operation Attack" DefaultData="14" />
  </TreeData>

  <!--
  Replacement: Simple City Defense

  Purpose:
  The base tree can get stuck around city garrison behavior. This replacement
  keeps the threatened-city check, then runs defense, recruitment, attack, and
  movement in a concurrent block.

  Expected in-game effect:
  Cities should recruit nearby defenders more aggressively, counterattack
  nearby units, and move defenders into useful positions instead of only trying
  to garrison.

  Rose correction from RH:
  RH labeled DefnId 1 on Operation Defend Units as AutoProtect Percentage, but
  the base game's NodeDataDefinitions say DefnId 0 is AutoProtect Percentage.
  This copy sets DefnId 0 for the intended value and keeps DefnId 1 near the
  base protect-outside-range value.
  -->
  <BehaviorTreeNodes>
    <Delete TreeName="Simple City Defense" />

    <Row NodeType="Concurrent" NodeId="0" TreeName="Simple City Defense" JumpTo="11" />
      <Row NodeType="Is City Threatened" NodeId="1" TreeName="Simple City Defense" />
      <Row NodeType="Operation Defend Units" NodeId="2" TreeName="Simple City Defense" />
      <Row NodeType="Concurrent" NodeId="3" TreeName="Simple City Defense" JumpTo="11" />
        <Row NodeType="Recruit Units" NodeId="4" TreeName="Simple City Defense" />
        <Row NodeType="Priority" NodeId="5" TreeName="Simple City Defense" JumpTo="8" />
          <Row NodeType="Can Alpha City" NodeId="6" TreeName="Simple City Defense" />
          <Row NodeType="Garrison City" NodeId="7" TreeName="Simple City Defense" />
        <Row NodeType="Operation Attack Units" NodeId="8" TreeName="Simple City Defense" />
        <Row NodeType="Operation Attack City" NodeId="9" TreeName="Simple City Defense" />
        <Row NodeType="Operation Move" NodeId="10" TreeName="Simple City Defense" />
  </BehaviorTreeNodes>

  <TreeData>
    <Delete TreeName="Simple City Defense" />

    <Row DefnId="0" NodeId="2" TreeName="Simple City Defense" DefaultData="25" /> <!-- Defend Units: AutoProtect Percentage. -->
    <Row DefnId="1" NodeId="2" TreeName="Simple City Defense" DefaultData="5" /> <!-- Defend Units: Protect Outside Range. -->
    <Row DefnId="0" NodeId="4" TreeName="Simple City Defense" DefaultData="true" /> <!-- Recruit Units: already in progress. -->
    <Row DefnId="2" NodeId="4" TreeName="Simple City Defense" DefaultData="15" /> <!-- Recruit Units: recruit range. -->
    <Row DefnId="6" NodeId="4" TreeName="Simple City Defense" DefaultData="true" /> <!-- Recruit Units: allow stealing units from other teams. -->
    <Row DefnId="7" NodeId="4" TreeName="Simple City Defense" DefaultData="true" /> <!-- Recruit Units: allow levying. -->
    <Row DefnId="0" NodeId="8" TreeName="Simple City Defense" DefaultData="true" /> <!-- Attack Units: nearby units. -->
    <Row DefnId="1" NodeId="8" TreeName="Simple City Defense" DefaultData="true" /> <!-- Attack Units: along march. -->
    <Row DefnId="2" NodeId="8" TreeName="Simple City Defense" DefaultData="true" /> <!-- Attack Units: allow unequal attacks. -->
    <Row DefnId="0" NodeId="10" TreeName="Simple City Defense" DefaultData="1" /> <!-- Move To enum. -->
    <Row DefnId="1" NodeId="10" TreeName="Simple City Defense" DefaultData="1" /> <!-- Range to goal. -->
    <Row DefnId="2" NodeId="10" TreeName="Simple City Defense" DefaultData="true" /> <!-- Validate new units. -->
    <Row DefnId="3" NodeId="10" TreeName="Simple City Defense" DefaultData="2" /> <!-- Unit spacing. -->
    <Row DefnId="5" NodeId="10" TreeName="Simple City Defense" DefaultData="true" /> <!-- Keep moving node running. -->
  </TreeData>

  <!--
  Replacement: Naval Superiority Tree

  Purpose:
  Turn a visible Lua-selected enemy ship into a focused, time-boxed interception.
  One seeded naval-melee ship may recruit at most two nearby uncommitted ships.

  Expected in-game effect:
  Small fleets should close on enemy ships and attack without absorbing the
  entire nearby navy, recruiting Great Admirals, or failing because no coastal
  pillage target happens to exist.

  Rose keeps the base tree's distinct initial and ongoing recruitment phases,
  but neither phase may create units or steal from other operations. Dynamic
  target selection does not fail when the originally observed ship disappears;
  a patrol sibling keeps the surviving force useful during the short retry
  window. The base Naval Pillage branch remains omitted.
  -->
  <BehaviorTreeNodes>
    <Delete TreeName="Naval Superiority Tree" />

    <Row NodeType="Sequence" NodeId="0" TreeName="Naval Superiority Tree" JumpTo="15" />
      <Row NodeType="Decode Trigger" NodeId="1" TreeName="Naval Superiority Tree" />
      <Row NodeType="Concurrent" NodeId="2" TreeName="Naval Superiority Tree" JumpTo="6" />
        <Row NodeType="Operation Defend Units" NodeId="3" TreeName="Naval Superiority Tree" />
        <Row NodeType="Recruit Units" NodeId="4" TreeName="Naval Superiority Tree" />
        <Row NodeType="Operation Attack Units" NodeId="5" TreeName="Naval Superiority Tree" />
      <Row NodeType="Turn Limiter" NodeId="6" TreeName="Naval Superiority Tree" JumpTo="15" />
        <Row NodeType="Concurrent" NodeId="7" TreeName="Naval Superiority Tree" JumpTo="15" />
          <Row NodeType="Recruit Units" NodeId="8" TreeName="Naval Superiority Tree" />
          <Row NodeType="Operation Defend Units" NodeId="9" TreeName="Naval Superiority Tree" />
          <Row NodeType="Naval Choose Target" NodeId="10" TreeName="Naval Superiority Tree" JumpTo="14" />
            <Row NodeType="Concurrent" NodeId="11" TreeName="Naval Superiority Tree" JumpTo="14" />
              <Row NodeType="Operation Move" NodeId="12" TreeName="Naval Superiority Tree" />
              <Row NodeType="Operation Attack Units" NodeId="13" TreeName="Naval Superiority Tree" />
          <Row NodeType="Naval Patrol" NodeId="14" TreeName="Naval Superiority Tree" />
  </BehaviorTreeNodes>

  <TreeData>
    <Delete TreeName="Naval Superiority Tree" />

    <Row DefnId="0" NodeId="1" TreeName="Naval Superiority Tree" Tag="Unused" />
    <Row DefnId="1" NodeId="1" TreeName="Naval Superiority Tree" />
    <Row DefnId="2" NodeId="1" TreeName="Naval Superiority Tree" />
    <Row DefnId="3" NodeId="1" TreeName="Naval Superiority Tree" />
    <Row DefnId="4" NodeId="1" TreeName="Naval Superiority Tree" />
    <Row DefnId="5" NodeId="1" TreeName="Naval Superiority Tree" />
    <Row DefnId="6" NodeId="1" TreeName="Naval Superiority Tree" />
    <Row DefnId="7" NodeId="1" TreeName="Naval Superiority Tree" />
    <Row DefnId="8" NodeId="1" TreeName="Naval Superiority Tree" Tag="Present Value" />
    <!--
    Keep the ongoing branch alive for the full interception window. Without
    Limit Is Min, setup can succeed before move/attack receives another tick.
    -->
    <Row DefnId="0" NodeId="3" TreeName="Naval Superiority Tree" DefaultData="35" />
    <Row DefnId="0" NodeId="4" TreeName="Naval Superiority Tree" DefaultData="false" /> <!-- Initial recruitment phase. -->
    <Row DefnId="2" NodeId="4" TreeName="Naval Superiority Tree" DefaultData="6" />
    <Row DefnId="3" NodeId="4" TreeName="Naval Superiority Tree" DefaultData="false" /> <!-- Existing ships only. -->
    <Row DefnId="4" NodeId="4" TreeName="Naval Superiority Tree" Tag="Present Value" />
    <Row DefnId="5" NodeId="4" TreeName="Naval Superiority Tree" DefaultData="6" />
    <Row DefnId="6" NodeId="4" TreeName="Naval Superiority Tree" DefaultData="false" /> <!-- Do not steal from other operations. -->
    <Row DefnId="0" NodeId="5" TreeName="Naval Superiority Tree" DefaultData="true" />
    <Row DefnId="1" NodeId="5" TreeName="Naval Superiority Tree" DefaultData="false" />
    <Row DefnId="2" NodeId="5" TreeName="Naval Superiority Tree" DefaultData="false" />
    <Row DefnId="3" NodeId="5" TreeName="Naval Superiority Tree" DefaultData="false" />
    <Row DefnId="0" NodeId="6" TreeName="Naval Superiority Tree" DefaultData="8" />
    <Row DefnId="1" NodeId="6" TreeName="Naval Superiority Tree" DefaultData="false" /> <!-- Finish cleanly after success. -->
    <Row DefnId="2" NodeId="6" TreeName="Naval Superiority Tree" DefaultData="true" /> <!-- Eight-turn minimum window. -->
    <Row DefnId="0" NodeId="7" TreeName="Naval Superiority Tree" DefaultData="1" /> <!-- Tolerate one failed sibling, normally Naval Patrol. -->
    <Row DefnId="0" NodeId="8" TreeName="Naval Superiority Tree" DefaultData="true" /> <!-- Ongoing recruitment phase. -->
    <Row DefnId="2" NodeId="8" TreeName="Naval Superiority Tree" DefaultData="6" />
    <Row DefnId="3" NodeId="8" TreeName="Naval Superiority Tree" DefaultData="false" /> <!-- Existing ships only. -->
    <Row DefnId="4" NodeId="8" TreeName="Naval Superiority Tree" Tag="Present Value" />
    <Row DefnId="5" NodeId="8" TreeName="Naval Superiority Tree" DefaultData="6" />
    <Row DefnId="6" NodeId="8" TreeName="Naval Superiority Tree" DefaultData="false" /> <!-- Do not steal from other operations. -->
    <Row DefnId="0" NodeId="9" TreeName="Naval Superiority Tree" DefaultData="35" />
    <Row DefnId="0" NodeId="10" TreeName="Naval Superiority Tree" DefaultData="DOMAIN_SEA" />
    <Row DefnId="1" NodeId="10" TreeName="Naval Superiority Tree" DefaultData="false" /> <!-- Retry when no naval target is currently available. -->
    <Row DefnId="0" NodeId="12" TreeName="Naval Superiority Tree" DefaultData="1" />
    <Row DefnId="1" NodeId="12" TreeName="Naval Superiority Tree" DefaultData="3" />
    <Row DefnId="2" NodeId="12" TreeName="Naval Superiority Tree" DefaultData="false" />
    <Row DefnId="3" NodeId="12" TreeName="Naval Superiority Tree" DefaultData="3" />
    <Row DefnId="0" NodeId="13" TreeName="Naval Superiority Tree" DefaultData="true" />
    <Row DefnId="1" NodeId="13" TreeName="Naval Superiority Tree" DefaultData="false" />
    <Row DefnId="2" NodeId="13" TreeName="Naval Superiority Tree" DefaultData="false" />
    <Row DefnId="3" NodeId="13" TreeName="Naval Superiority Tree" DefaultData="false" />
  </TreeData>

  <!--
  Replacement: Siege City Assault

  Purpose:
  The base tree has no time limit on initial assembly. Its contract manager
  keeps issuing new production contracts, so an operation that never becomes
  ready can hold its units at the rally point for dozens of turns (logged:
  47 and 52 turns). Rose copies the base tree and wraps the assembly block in
  a failing Turn Limiter (Node 7). Turn Limiters fail at about half their
  Turns to Run in game turns (logged "7 of 15" failures, also in untouched
  base trees), so 30 gives about 15 turns. When it expires the operation ends
  and the AI can re-plan with a fresh target and odds check.

  Inserting Node 7 shifts every later base NodeId by one. The TreeData below is
  the base data with Rose's earlier tuning carried to the shifted ids:
  - Shorter contract/recruit limits (Nodes 11, 12) and phase limits (18, 33).
  - Node 27 pre-war limiter (base Node 26) runs seven turns so its five-turn
    diplomacy contract receives a count-six resolution tick before count seven fails.
  - Stealing allowed only during initial assembly (Node 12); later recruit
    nodes (23, 37, 45) use a 12-tile range and cannot strip distant operations.
  Generated and checked by .scratch/siege-gather-limit (gen_tree.py, verify.py).
  -->
  <BehaviorTreeNodes>
    <Delete TreeName="Siege City Assault" />

    <Row NodeType="Concurrent" NodeId="0" TreeName="Siege City Assault" JumpTo="58" />
      <Row NodeType="Decode Trigger" NodeId="1" TreeName="Siege City Assault" />
      <Row NodeType="Priority" NodeId="2" TreeName="Siege City Assault" JumpTo="5" />
        <Row NodeType="Can Alpha City" NodeId="3" TreeName="Siege City Assault" />
        <Row NodeType="Operation Defend Units" NodeId="4" TreeName="Siege City Assault" />
      <Row NodeType="Operation Change Target" NodeId="5" TreeName="Siege City Assault" />
      <Row NodeType="Sequence" NodeId="6" TreeName="Siege City Assault" JumpTo="58" />
        <Row NodeType="Turn Limiter" NodeId="7" TreeName="Siege City Assault" JumpTo="16" /> <!-- Rose: fail initial assembly after about 15 turns. -->
          <Row NodeType="Concurrent" NodeId="8" TreeName="Siege City Assault" JumpTo="16" />
            <Row NodeType="Priority" NodeId="9" TreeName="Siege City Assault" JumpTo="13" />
              <Row NodeType="Operation Is Ready" NodeId="10" TreeName="Siege City Assault" />
              <Row NodeType="Contract Manager Decorator" NodeId="11" TreeName="Siege City Assault" JumpTo="13" />
                <Row NodeType="Recruit Units" NodeId="12" TreeName="Siege City Assault" />
            <Row NodeType="Operation Attack Units" NodeId="13" TreeName="Siege City Assault" />
            <Row NodeType="Make Formation" NodeId="14" TreeName="Siege City Assault" />
            <Row NodeType="Operation Move" NodeId="15" TreeName="Siege City Assault" />
        <Row NodeType="Lock Units" NodeId="16" TreeName="Siege City Assault" />
        <Row NodeType="Operation Diplomacy" NodeId="17" TreeName="Siege City Assault" />
        <Row NodeType="Turn Limiter" NodeId="18" TreeName="Siege City Assault" JumpTo="26" />
          <Row NodeType="Priority" NodeId="19" TreeName="Siege City Assault" JumpTo="26" />
            <Row NodeType="Is At War" NodeId="20" TreeName="Siege City Assault" />
            <Row NodeType="Concurrent" NodeId="21" TreeName="Siege City Assault" JumpTo="26" />
              <Row NodeType="Operation Change Target" NodeId="22" TreeName="Siege City Assault" />
              <Row NodeType="Recruit Units" NodeId="23" TreeName="Siege City Assault" />
              <Row NodeType="Operation Attack Units" NodeId="24" TreeName="Siege City Assault" />
              <Row NodeType="Operation Move" NodeId="25" TreeName="Siege City Assault" />
        <Row NodeType="Concurrent" NodeId="26" TreeName="Siege City Assault" JumpTo="33" />
          <Row NodeType="Turn Limiter" NodeId="27" TreeName="Siege City Assault" JumpTo="30" />
            <Row NodeType="Contract Manager Decorator" NodeId="28" TreeName="Siege City Assault" JumpTo="30" />
              <Row NodeType="Operation Diplomacy" NodeId="29" TreeName="Siege City Assault" />
          <Row NodeType="Operation Attack Units" NodeId="30" TreeName="Siege City Assault" />
          <Row NodeType="Turn Limiter" NodeId="31" TreeName="Siege City Assault" JumpTo="33" />
            <Row NodeType="Operation Move" NodeId="32" TreeName="Siege City Assault" />
        <Row NodeType="Turn Limiter" NodeId="33" TreeName="Siege City Assault" JumpTo="43" />
          <Row NodeType="Concurrent" NodeId="34" TreeName="Siege City Assault" JumpTo="43" />
            <Row NodeType="Is At War" NodeId="35" TreeName="Siege City Assault" />
            <Row NodeType="Operation Change Target" NodeId="36" TreeName="Siege City Assault" />
            <Row NodeType="Recruit Units" NodeId="37" TreeName="Siege City Assault" />
            <Row NodeType="Operation Attack Units" NodeId="38" TreeName="Siege City Assault" />
            <Row NodeType="Operation Air Assault" NodeId="39" TreeName="Siege City Assault" />
            <Row NodeType="Operation Pillage" NodeId="40" TreeName="Siege City Assault" />
            <Row NodeType="Operation Siege City" NodeId="41" TreeName="Siege City Assault" />
            <Row NodeType="Operation Move" NodeId="42" TreeName="Siege City Assault" />
        <Row NodeType="Concurrent" NodeId="43" TreeName="Siege City Assault" JumpTo="58" />
          <Row NodeType="Operation Change Target" NodeId="44" TreeName="Siege City Assault" />
          <Row NodeType="Recruit Units" NodeId="45" TreeName="Siege City Assault" />
          <Row NodeType="Priority" NodeId="46" TreeName="Siege City Assault" JumpTo="50" />
            <Row NodeType="Not" NodeId="47" TreeName="Siege City Assault" JumpTo="49" />
              <Row NodeType="Can Alpha City" NodeId="48" TreeName="Siege City Assault" />
            <Row NodeType="Operation Attack City" NodeId="49" TreeName="Siege City Assault" />
          <Row NodeType="Operation Attack Units" NodeId="50" TreeName="Siege City Assault" />
          <Row NodeType="Operation Pillage" NodeId="51" TreeName="Siege City Assault" />
          <Row NodeType="Operation Siege City" NodeId="52" TreeName="Siege City Assault" />
          <Row NodeType="Build Military Improvement" NodeId="53" TreeName="Siege City Assault" />
          <Row NodeType="Operation Air Assault" NodeId="54" TreeName="Siege City Assault" />
          <Row NodeType="Operation Attack City" NodeId="55" TreeName="Siege City Assault" />
          <Row NodeType="Operation Pillage" NodeId="56" TreeName="Siege City Assault" />
          <Row NodeType="Operation Move" NodeId="57" TreeName="Siege City Assault" />
  </BehaviorTreeNodes>

  <TreeData>
    <Delete TreeName="Siege City Assault" />

    <Row DefnId="0" NodeId="1" TreeName="Siege City Assault" Tag="Unused" />
    <Row DefnId="1" NodeId="1" TreeName="Siege City Assault" />
    <Row DefnId="2" NodeId="1" TreeName="Siege City Assault" />
