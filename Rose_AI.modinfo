    <File>core/military/trees/Simple_City_Defense.xml</File>
    <File>core/military/trees/Naval_Superiority.xml</File>
    <File>core/military/trees/Siege_City_Assault.xml</File>
    <File>core/military/trees/Early_City_Assault.xml</File>
    <File>core/military/trees/Nuclear_Assault.xml</File>
    <File>core/military/trees/Rose_Nuclear_Strike.xml</File>
    <File>core/military/trees/Rose_Wartime_Siege.xml</File>
    <File>core/scripts/Rose_AI_Gameplay.lua</File>
    <File>core/scripts/Rose_AI_Core.lua</File>
    <File>core/scripts/Rose_AI_Civics.lua</File>
    <File>core/scripts/Rose_AI_Strategies.lua</File>
    <File>core/scripts/Rose_AI_Naval.lua</File>
    <File>core/scripts/Rose_AI_Nuclear.lua</File>
    <File>core/scripts/Rose_AI_Director.lua</File>
    <File>core/scripts/Rose_AI_Diagnostics.lua</File>
    <File>core/scripts/Rose_AI_ChoiceMarkers.lua</File>
    <File>core/scripts/Rose_AI_InGame.lua</File>
    <File>core/scripts/Rose_AI_InGame.xml</File>
  </Files>
</Mod>
